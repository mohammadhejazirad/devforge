{
  "tools": [
    {
      "name": "php",
      "summary": "PHP CLI and FPM from the distro, with a side-by-side default",
      "category": "runtime",
      "strategy": "package",
      "binaries": [
        "php"
      ],
      "version_args": [
        "-v"
      ],
      "version_regex": "PHP (\\d+\\.\\d+\\.\\d+)",
      "shims": [
        "php"
      ],
      "project_files": [
        ".php-version"
      ],
      "packages": {
        "debian": [
          "php-cli",
          "php-fpm"
        ],
        "rhel": [
          "php-cli",
          "php-fpm"
        ],
        "arch": [
          "php",
          "php-fpm"
        ],
        "suse": [
          "php8",
          "php8-fpm"
        ],
        "alpine": [
          "php",
          "php-fpm"
        ]
      },
      "versioned_packages": {
        "debian": [
          "php{major}.{minor}-cli",
          "php{major}.{minor}-fpm"
        ],
        "alpine": [
          "php{major}{minor}",
          "php{major}{minor}-fpm"
        ]
      },
      "system_bins": [
        "php{mm}",
        "php{compact}"
      ],
      "alternatives": [
        [
          "php",
          "/usr/bin/php{major}.{minor}"
        ],
        [
          "php-fpm",
          "/usr/sbin/php-fpm{major}.{minor}"
        ]
      ]
    },
    {
      "name": "node",
      "summary": "Node.js from nodejs.org, installed side by side",
      "category": "runtime",
      "strategy": "archive",
      "binaries": [
        "node"
      ],
      "version_args": [
        "--version"
      ],
      "version_regex": "v?(\\d+\\.\\d+\\.\\d+)",
      "shims": [
        "node",
        "npm",
        "npx",
        "corepack"
      ],
      "project_files": [
        ".nvmrc",
        ".node-version"
      ],
      "coexist_dirs": [
        ".nvm"
      ],
      "coexist_env": [
        "NVM_DIR"
      ],
      "fallback_packages": {
        "debian": [
          "nodejs"
        ],
        "rhel": [
          "nodejs"
        ],
        "arch": [
          "nodejs"
        ],
        "suse": [
          "nodejs"
        ],
        "alpine": [
          "nodejs"
        ]
      },
      "archive": {
        "format": "tar.xz",
        "url": "https://nodejs.org/dist/v{version}/node-v{version}-linux-{arch}.tar.xz",
        "checksum_url": "https://nodejs.org/dist/v{version}/SHASUMS256.txt",
        "checksum_format": "sums",
        "arch_map": {
          "amd64": "x64",
          "arm64": "arm64",
          "arm": "armv7l"
        },
        "libc_arch_map": {
          "musl": {
            "amd64": "x64-musl"
          }
        }
      }
    },
    {
      "name": "go",
      "summary": "Go from go.dev, installed side by side",
